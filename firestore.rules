rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveTenant(tenantId) {
      return signedIn() &&
        request.auth.token.tenantId == tenantId &&
        request.auth.token.status == 'ACTIVE';
    }

    function isTenant(tenantId) {
      return isActiveTenant(tenantId);
    }

    function hasTenantPayload(tenantId) {
      return request.resource.data.tenantId == tenantId;
    }

    function hasPermission(permission) {
      return signedIn() &&
        request.auth.token.permissions is list &&
        permission in request.auth.token.permissions;
    }

    function isOrgAdmin(tenantId) {
      return isActiveTenant(tenantId) &&
        request.auth.token.role == 'ORG_ADMIN';
    }

    function tenantUserPath(tenantId, uid) {
      return /databases/$(database)/documents/organizations/$(tenantId)/users/$(uid);
    }

    function requesterProfile(tenantId) {
      return get(tenantUserPath(tenantId, request.auth.uid)).data;
    }

    function requesterProfileIsActive(tenantId) {
      return isActiveTenant(tenantId) &&
        exists(tenantUserPath(tenantId, request.auth.uid)) &&
        requesterProfile(tenantId).tenantId == tenantId &&
        requesterProfile(tenantId).status == 'ACTIVE';
    }

    function isRcaSessionOpen(tenantId, incidentId, sessionId) {
      return exists(/databases/$(database)/documents/organizations/$(tenantId)/rcaIncidents/$(incidentId)/rcaSessions/$(sessionId)) &&
        get(/databases/$(database)/documents/organizations/$(tenantId)/rcaIncidents/$(incidentId)/rcaSessions/$(sessionId)).data.status != 'CLOSED';
    }

    function isDepartmentAdminFor(tenantId, departmentId, permission) {
      return requesterProfileIsActive(tenantId) &&
        request.auth.token.role == 'DEPT_ADMIN' &&
        hasPermission(permission) &&
        requesterProfile(tenantId).role == 'DEPT_ADMIN' &&
        requesterProfile(tenantId).departmentId == departmentId;
    }

    function canReadTenantUser(tenantId, userId) {
      return requesterProfileIsActive(tenantId) &&
        (
          request.auth.uid == userId ||
          (isOrgAdmin(tenantId) && (hasPermission('users.manage') || hasPermission('users.invite'))) ||
          isDepartmentAdminFor(tenantId, resource.data.departmentId, 'users.invite')
        );
    }

    function canReadApprovedPhone(tenantId) {
      return requesterProfileIsActive(tenantId) &&
        (
          (isOrgAdmin(tenantId) && (hasPermission('users.manage') || hasPermission('users.invite'))) ||
          isDepartmentAdminFor(tenantId, resource.data.departmentId, 'users.invite')
        );
    }

    function isDirectChatParticipant(tenantId, chatId) {
      return requesterProfileIsActive(tenantId) &&
        exists(/databases/$(database)/documents/organizations/$(tenantId)/directChats/$(chatId)) &&
        get(/databases/$(database)/documents/organizations/$(tenantId)/directChats/$(chatId)).data.tenantId == tenantId &&
        get(/databases/$(database)/documents/organizations/$(tenantId)/directChats/$(chatId)).data.participantIds.hasAny([request.auth.uid]);
    }

    match /identityDirectory/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /approvedPhoneDirectory/{phoneHash} {
      allow read, write: if false;
    }

    match /auditLogs/{auditLogId} {
      allow read, write: if false;
    }

    match /organizations/{tenantId} {
      allow read: if requesterProfileIsActive(tenantId);
      allow create, update, delete: if false;

      match /users/{userId} {
        allow get, list: if canReadTenantUser(tenantId, userId);
        allow create, update, delete: if false;

        match /devices/{deviceId} {
          allow get, list: if requesterProfileIsActive(tenantId) && request.auth.uid == userId;
          allow create, update, delete: if false;
        }

        match /chatBackups/{backupId} {
          allow get, list: if requesterProfileIsActive(tenantId) && request.auth.uid == userId;
          allow create, update, delete: if false;
        }
      }

      match /approvedPhones/{phoneId} {
        allow get, list: if canReadApprovedPhone(tenantId);
        allow create, update, delete: if false;
      }

      match /departments/{departmentId} {
        allow get, list: if requesterProfileIsActive(tenantId);
        allow create, update, delete: if false;
      }

      match /roles/{roleId} {
        allow get, list: if requesterProfileIsActive(tenantId);
        allow create, update, delete: if false;
      }

      match /groups/{groupId} {
        allow get, list: if requesterProfileIsActive(tenantId) &&
          (
            resource.data.scope == 'COMPANY' ||
            resource.data.departmentId == requesterProfile(tenantId).departmentId ||
            isOrgAdmin(tenantId)
          );
        allow create, update, delete: if false;

        match /members/{memberUid} {
          allow get, list: if requesterProfileIsActive(tenantId) &&
            (request.auth.uid == memberUid || isOrgAdmin(tenantId));
          allow create, update, delete: if false;
        }
      }

      match /directChats/{chatId} {
        allow get, list: if requesterProfileIsActive(tenantId) &&
          resource.data.tenantId == tenantId &&
          resource.data.participantIds.hasAny([request.auth.uid]);
        allow create, update, delete: if false;

        match /encryptedEnvelopes/{envelopeId} {
          allow get, list: if isDirectChatParticipant(tenantId, chatId) &&
            resource.data.tenantId == tenantId &&
            (
              resource.data.senderUid == request.auth.uid ||
              resource.data.recipientUid == request.auth.uid
            );
          allow create, update, delete: if false;
        }

        match /receiptSummaries/{receiptId} {
          allow get, list: if isDirectChatParticipant(tenantId, chatId);
          allow create, update, delete: if false;
        }
      }

      /**
       * Denied to clients, including reads.
       *
       * These documents hold far more than the public keys a sender needs:
       * `appInstallationId`, `platform`, `lastSeenAt`, `uid`, `status`,
       * `revokedByUid` and `revocationReason`. A single list call returned a
       * live inventory of every device in the company and who was using it,
       * to any employee.
       *
       * The keys themselves still reach senders, through the encryption-context
       * endpoints in `profileRoutes`, which return exactly the six public
       * fields of `EncryptionDevicePublicKey` and nothing else.
       */
      match /deviceKeys/{deviceId} {
        allow read, write: if false;
      }

      match /files/{fileId} {
        allow read, write: if false;
      }

      match /announcements/{announcementId} {
        allow read, write: if false;
      }

      match /workOrders/{workOrderId} {
        allow read, write: if false;
      }

      match /actionPlans/{actionPlanId} {
        allow read, write: if false;
      }

      match /railsItems/{railsItemId} {
        allow read, write: if false;

        match /activity/{activityId} {
          allow read, write: if false;
        }
      }

      match /railsAuditEvents/{eventId} {
        allow read, write: if false;
      }

      match /railsNotificationQueue/{notificationId} {
        allow read, write: if false;
      }

      match /notificationEvents/{eventId} {
        allow read, write: if false;
      }

      /**
       * Everything about a root cause analysis, denied to clients.
       *
       * These rules used to let any active employee read and write every
       * incident, session, node, CAPA action, audit signature and evidence log
       * in their company. The backend is far narrower — `canAccessRcaIncident`
       * requires the caller to have created the incident or be named in
       * `participantUids` — so an ordinary employee could bypass the
       * participant model entirely with their own ID token and the Firestore
       * REST API.
       *
       * The data is exactly what the codebase elsewhere refuses to send to a
       * third party: who was involved, whether anyone was injured, who reported
       * it, lot numbers and shift records. An injury investigation readable by
       * the whole plant floor.
       *
       * Writes were worse. The only content check was that the *existing*
       * document was not CLOSED, so `createdByUid`, `participantUids`,
       * `rootCause` and `status` were all client-settable — while the backend
       * refuses to reopen a closed RCA outside a governed workflow. In food
       * manufacturing that record is regulatory evidence.
       *
       * A recursive wildcard rather than a rule per collection, so a
       * subcollection added later cannot be left open by omission.
       */
      match /rcaIncidents/{document=**} {
        allow read, write: if false;
      }

      match /auditLogs/{auditLogId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
