{
  "expo": {
    "name": "Synzapp",
    "slug": "synzapp-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "synzapp",
    "icon": "./assets/icon.png",
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.synzapp.mobile",
      "buildNumber": "4",
      "appleTeamId": "F9M458TK87",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.synzapp.mobile",
          "$(AppIdentifierPrefix)com.synzapp.mobile.shared"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Synzapp uses the camera when you choose to take a profile photo or send a chat photo.",
        "NSContactsUsageDescription": "Synzapp uses contacts you select to invite approved employees to your company workspace.",
        "NSBluetoothAlwaysUsageDescription": "Synzapp uses Bluetooth when you choose a headset for secure workplace calls.",
        "NSMicrophoneUsageDescription": "Synzapp uses the microphone when you choose to record a voice note or join a secure workplace call.",
        "NSPhotoLibraryUsageDescription": "Synzapp uses photos and videos you choose for your profile photo or chat messages.",
        "NSLocalNetworkUsageDescription": "Synzapp connects to your local development server while testing local builds on your network.",
        "NSBonjourServices": [
          "_expo._tcp",
          "_react-native-packager._tcp",
          "_http._tcp"
        ],
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "voip"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.synzapp.mobile",
      "versionCode": 3,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E20603"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#16A34A"
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#16A34A",
          "defaultChannel": "chat-messages"
        }
      ],
      "./plugins/withSynzappAndroidNotificationPreview",
      "expo-document-picker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Synzapp uses calendar access when you choose to add scheduled workplace calls to your device calendar."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Synzapp uses the camera when you choose to take a profile photo or send a chat photo.",
          "photosPermission": "Synzapp uses photos and videos you choose for your profile photo or chat messages."
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "enableBackgroundRecording": true,
          "microphonePermission": "Synzapp uses the microphone for secure workplace calls, voice notes, and live interpreter sessions."
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.0",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth"
            ],
            "useFrameworks": "static"
          }
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "495fd669-3ddf-4062-adfd-5648dca501c8"
      }
    },
    "owner": "geraldnyah",
    "runtimeVersion": "0.1.0",
    "updates": {
      "url": "https://u.expo.dev/495fd669-3ddf-4062-adfd-5648dca501c8"
    }
  }
}
