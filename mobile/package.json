{
  "name": "synzapp-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "audit:security": "npm audit --audit-level=moderate",
    "start": "expo start",
    "start:dev": "expo start --dev-client",
    "start:clear": "expo start --clear",
    "start:dev:clear": "expo start --dev-client --clear",
    "build:preflight": "node scripts/check-native-build-files.js",
    "build:dev:android": "npm run build:preflight && npx eas-cli@20.1.0 build --profile development --platform android",
    "build:dev:ios": "npm run build:preflight && npx eas-cli@20.1.0 build --profile development --platform ios",
    "build:dev:all": "npm run build:preflight && npx eas-cli@20.1.0 build --profile development --platform all",
    "build:preview:android": "npm run build:preflight && npx eas-cli@20.1.0 build --profile preview --platform android",
    "build:preview:ios": "npm run build:preflight && npx eas-cli@20.1.0 build --profile preview --platform ios",
    "build:preview:all": "npm run build:preflight && npx eas-cli@20.1.0 build --profile preview --platform all",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.1.1",
    "@react-native-firebase/auth": "^24.1.1",
    "base64-js": "^1.5.1",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.18",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-compressor": "^1.19.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0",
    "rn-emoji-keyboard": "^1.7.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
