{
  "name": "synzapp-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vitest run && vite build",
    "deploy": "npm run build && firebase deploy --only hosting:web --config ../firebase.json --project synzapp-a7ee3",
    "deploy:all": "npm run build && firebase deploy --only hosting:web,hosting:admin --config ../firebase.json --project synzapp-a7ee3",
    "deploy:console": "npm run build && firebase deploy --only hosting:admin --config ../firebase.json --project synzapp-a7ee3",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-context-menu": "^2.3.1",
    "@radix-ui/react-popover": "^1.1.17",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.11.1",
    "docx": "^9.7.1",
    "emoji-picker-react": "^4.19.1",
    "firebase": "^10.14.1",
    "heic2any": "^0.0.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.561.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.3",
    "react-colorful": "^5.7.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "vite": "^5.4.21",
    "xlsx": "^0.18.5",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
