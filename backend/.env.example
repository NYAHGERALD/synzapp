PORT=4100
CORS_ORIGIN=*

FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Optional for local development when GOOGLE_APPLICATION_CREDENTIALS is not used.
# Use a single-line JSON string copied from a Firebase service account.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Set true in staging/production after mobile App Check is configured.
SYNZAPP_REQUIRE_APP_CHECK=false

# Required before production. Used to hash phone numbers for lookup and rate limits.
PHONE_HASH_SECRET=change-this-before-production

AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX=5
