PORT=4100
# Named origins in production, never *. Comma separated.
CORS_ORIGIN=*

FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Optional for local development when GOOGLE_APPLICATION_CREDENTIALS is not used.
# Use a single-line JSON string copied from a Firebase service account.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Set true in staging/production after mobile App Check is configured.
SYNZAPP_REQUIRE_APP_CHECK=false

# Required in production, and the server refuses to start without them.
#
# These protect phone numbers, which are the only authentication factor the
# product has: one is the HMAC key for the lookup index, the other the AES key
# for the stored number. At least 32 characters, from Secret Manager in a real
# deployment. No value is written here on purpose - a placeholder in an example
# file is a placeholder that reaches production.
PHONE_HASH_SECRET=
PHONE_ENCRYPTION_SECRET=

AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_RATE_LIMIT_MAX=5

# OpenAI is only used server-side. Never put this key in the mobile app.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REQUEST_TIMEOUT_MS=25000

# Synzapp AI Interpreter. The mobile app receives only short-lived session secrets.
OPENAI_INTERPRETER_AGENT_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_INTERPRETER_REALTIME_MODEL=gpt-realtime-translate
OPENAI_INTERPRETER_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_INTERPRETER_SEGMENT_MODEL=gpt-5.6-terra
OPENAI_INTERPRETER_SEGMENT_TTS_MODEL=gpt-4o-mini-tts
OPENAI_INTERPRETER_SEGMENT_TTS_VOICE=cedar
OPENAI_INTERPRETER_SUMMARY_MODEL=gpt-5.6-terra
OPENAI_INTERPRETER_SUMMARY_TTS_MODEL=gpt-4o-mini-tts
OPENAI_INTERPRETER_SUMMARY_TTS_VOICE=cedar
INTERPRETER_MAX_TARGET_LANGUAGES=4
INTERPRETER_RETENTION_DAYS=90
INTERPRETER_AUDIO_RETENTION=false
INTERPRETER_SEGMENT_AUDIO_ENABLED=true
INTERPRETER_SUMMARY_ENABLED=true
INTERPRETER_SUMMARY_AUDIO_ENABLED=true
INTERPRETER_REMINDER_WORKER_ENABLED=true
INTERPRETER_REMINDER_WORKER_INTERVAL_MS=60000
INTERPRETER_REMINDER_WORKER_BATCH_SIZE=50
INTERPRETER_REMINDER_WORKER_TENANT_BATCH_SIZE=100
# Optional governed facts injected into interpreter realtime sessions.
# Keep this concise and update it through deployment configuration when facts change.
INTERPRETER_APPROVED_CURRENT_FACTS=
INTERPRETER_CURRENT_US_PRESIDENT=

# Required for iOS incoming calls while Synzapp is minimized.
# The APNs auth key must be enabled for the app identifier and VoIP Services capability.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=com.synzapp.mobile
# Use sandbox for development/internal builds and production for App Store/TestFlight production builds.
APNS_ENVIRONMENT=sandbox
