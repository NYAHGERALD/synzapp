rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveTenant(tenantId) {
      return signedIn() &&
        request.auth.token.tenantId == tenantId &&
        request.auth.token.status == 'ACTIVE';
    }

    match /organizations/{tenantId}/company/logo/{fileName} {
      allow read: if isActiveTenant(tenantId);
      allow write: if false;
    }

    match /organizations/{tenantId}/users/{uid}/profile/{fileName} {
      allow read: if isActiveTenant(tenantId);
      allow write: if false;
    }

    match /organizations/{tenantId}/users/{uid}/chat-backups/{fileName} {
      allow read: if isActiveTenant(tenantId) && request.auth.uid == uid;
      allow write: if false;
    }

    match /tenants/{tenantId}/chats/{chatId}/messageEnvelopes/{messageId}/encryptedAttachments/{fileId} {
      allow read, write: if false;
    }

    match /tenants/{tenantId}/workOrders/{workOrderId}/attachments/{fileId} {
      allow read, write: if false;
    }

    match /tenants/{tenantId}/actionPlans/{actionPlanId}/attachments/{fileId} {
      allow read, write: if false;
    }

    // Photos and video on a chat action.
    //
    // Both denied to clients. Uploads use a short lived signed link issued by
    // the backend after it has checked who is asking, and reads use a signed
    // link too. A client that could write here directly could put a file
    // under somebody else's name.
    match /organizations/{tenantId}/actionAttachments/{uid}/{fileId} {
      allow read, write: if false;
    }

    // An orphan path, and an open door.
    //
    // No real RCA evidence has ever lived here: the backend writes to
    // organizations/{tenantId}/rca/{incidentId}/sessions/{sessionId}/evidence/
    // through the Admin SDK, and serves it back only behind an authorised
    // route. What this rule actually granted was an unlimited, unaudited 50 MB
    // upload path into the customer's bucket, with no content-type check, that
    // no retention job knows about and nothing ever deletes.
    match /organizations/{tenantId}/rcaIncidents/{incidentId}/evidence/{fileName} {
      allow read, write: if false;
    }

    match /organizations/{tenantId}/railsItems/{railsItemId}/evidence/{fileName} {
      allow read, write: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
